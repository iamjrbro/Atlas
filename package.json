{
  "name": "atlas-identity-observatory",
  "version": "0.3.0",
  "private": true,
  "description": "Multi-tenant evidence-first identity, access and change observability for Azure and Microsoft 365",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/migrate.js",
    "tenant:add": "node --env-file-if-exists=.env scripts/add-tenant.js",
    "check": "node scripts/check.js",
    "test": "node --test --test-isolation=none test/*.test.js",
    "test:postgres": "node --env-file-if-exists=.env scripts/postgres-smoke.js"
  },
  "dependencies": {
    "@azure/msal-node": "7.1.0",
    "@electric-sql/pglite": "0.5.10",
    "connect-pg-simple": "10.0.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
