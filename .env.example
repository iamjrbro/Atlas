# A demonstração usa dados fictícios e não faz chamadas à Microsoft.
APP_MODE=demo
NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
DATABASE_URL=
DATABASE_SSL=disable
# Opcional. Vazio = demo em memória, recriada em cada inicialização.
# Persistência PGlite requer disco local compatível; evite pastas sincronizadas.
DEMO_DATABASE_PATH=
# Gere 48 bytes aleatórios. Obrigatório no modo microsoft.
SESSION_SECRET=
# Aplicativo WEB multitenant (Organizations), com app roles Atlas.*.
WEB_CLIENT_ID=
WEB_CLIENT_SECRET=
# Aplicativo COLLECTOR separado, multitenant, consentido em cada cliente.
COLLECTOR_CLIENT_ID=
COLLECTOR_CLIENT_SECRET=
# Alternativa ao segredo do collector: certificado PEM montado no servidor.
COLLECTOR_CERT_PATH=
COLLECTOR_CERT_THUMBPRINT=
# Admins verificados por token podem cadastrar o próprio tenant.
ALLOW_SELF_ONBOARDING=true
# Quantidade EXATA de proxies confiáveis em frente ao contêiner.
TRUST_PROXY_HOPS=0
COLLECTION_INTERVAL_SECONDS=900
MAX_PAGES_PER_RUN=100
MAX_RECORDS_PER_RUN=50000
EVENT_OVERLAP_MINUTES=60
# Tenant do publicador, necessário para cota dedicada da Management Activity API.
PUBLISHER_TENANT_ID=
# Somente no servidor/Key Vault. JSON {"TENANT_UUID":"SEGREDO_ALEATORIO_32+"}.
BRIDGE_HMAC_KEYS_JSON={}
